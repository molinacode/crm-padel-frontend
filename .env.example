# Este archivo es SOLO para el frontend (Vite).
# NO es el mismo que crm-padel-backend/.env — cada proyecto lee el suyo.
#
# Copia a ".env" en esta carpeta (crm-padel-frontend) y reinicia "pnpm run dev".
#
# Dashboard Supabase → Settings → API:
#   - Project URL → VITE_SUPABASE_URL
#   - anon public → VITE_SUPABASE_KEY (o VITE_SUPABASE_ANON_KEY)
#
# NUNCA pongas aqui la clave "service_role" (solo backend / Edge con RLS off).
# Si una service_role llego al navegador, rota la clave en Supabase:
#   Settings → API → Reset service_role secret.

VITE_SUPABASE_URL=https://TU_REF.supabase.co
VITE_SUPABASE_KEY=pega_aqui_la_clave_anon_public
